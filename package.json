{
  "name": "orbit",
  "version": "0.1.4",
  "description": "ORBIT — Gaming Launcher Console UI",
  "main": "./out/main/index.js",
  "author": "Luis Garcia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
