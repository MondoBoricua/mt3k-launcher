<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseUwp>true</UseUwp>
    <UseUwpTools>false</UseUwpTools>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>OrbitHud</AssemblyName>
    <RootNamespace>OrbitHud</RootNamespace>
    <Version>0.1.0</Version>
    <XboxGameBar-Platform>x64</XboxGameBar-Platform>
    <CsWinRTIncludes>Microsoft.Gaming.XboxGameBar</CsWinRTIncludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Views/HudView.xaml" />
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2607010" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <CsWinRTInputs Include="$(NuGetPackageRoot)/microsoft.gaming.xboxgamebar/7.3.2607010/lib/uap10.0/Microsoft.Gaming.XboxGameBar.winmd" />
    <Content Include="$(NuGetPackageRoot)/microsoft.gaming.xboxgamebar/7.3.2607010/runtimes/win10-x64/native/Microsoft.Gaming.XboxGameBar.dll" Link="Microsoft.Gaming.XboxGameBar.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.gaming.xboxgamebar/7.3.2607010/lib/uap10.0/Microsoft.Gaming.XboxGameBar.winmd" Link="Microsoft.Gaming.XboxGameBar.winmd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/microsoft.gaming.xboxgamebar/7.3.2607010/private/Microsoft.Gaming.XboxGameBar.Private.winmd" Link="Microsoft.Gaming.XboxGameBar.Private.winmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
