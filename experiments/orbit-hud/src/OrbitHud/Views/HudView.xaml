<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="HudRoot" RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">
  <Grid.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#101316" />
    <SolidColorBrush x:Key="CardBrush" Color="#1B2025" />
    <SolidColorBrush x:Key="LineBrush" Color="#343C44" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9B4BE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#83E4CA" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#102B24" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CharacterSpacing" Value="120" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ActionStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CanvasBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="3" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionStyle}" />
    <Style TargetType="ToggleSwitch">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CanvasBrush}" />
    </Style>
  </Grid.Resources>
  <Border x:Name="Surface" Background="{StaticResource CanvasBrush}" />
  <Grid x:Name="FullView" Padding="24,18,24,14" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid Width="38" Height="38" VerticalAlignment="Center">
        <Ellipse Width="30" Height="20" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform Angle="-32" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="ORBIT HUD" FontSize="20" FontWeight="SemiBold" CharacterSpacing="60" />
        <TextBlock Text="PREVIEW 01" Style="{StaticResource LabelStyle}" FontSize="9" />
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="2" Width="44" MinHeight="44" Padding="0" Background="Transparent" BorderThickness="0">
        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button x:Name="HomeNav" />
      <Button x:Name="TimerNav" Grid.Column="1" />
      <Button x:Name="SettingsNav" Grid.Column="2" />
    </Grid>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False" VerticalScrollMode="Enabled">
      <Grid x:Name="ContentHost" Padding="3,3,8,8">
        <Grid.RenderTransform><TranslateTransform x:Name="ContentTranslation" /></Grid.RenderTransform>
        <StackPanel x:Name="HomePage" Spacing="18">
          <StackPanel Spacing="5">
            <TextBlock x:Name="Eyebrow" Style="{StaticResource LabelStyle}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="Subheading" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE7FC;" FontSize="23" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock x:Name="ContextLabel" Style="{StaticResource LabelStyle}" />
                <TextBlock x:Name="ContextValue" FontWeight="SemiBold" MaxLines="3" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18,16">
              <StackPanel Spacing="10">
                <TextBlock x:Name="ClockLabel" Style="{StaticResource LabelStyle}" />
                <TextBlock x:Name="ClockValue" FontSize="34" FontWeight="SemiLight" TextWrapping="NoWrap" />
                <TextBlock x:Name="DateValue" FontSize="12" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18,16">
              <StackPanel Spacing="10">
                <TextBlock x:Name="BatteryLabel" Style="{StaticResource LabelStyle}" />
                <TextBlock x:Name="BatteryValue" FontSize="34" FontWeight="SemiLight" TextWrapping="NoWrap" />
                <TextBlock x:Name="BatteryState" FontSize="12" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </Border>
          </Grid>
          <Button x:Name="TimerCard" HorizontalContentAlignment="Stretch" Padding="18" CornerRadius="16">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="8">
                <TextBlock x:Name="SessionLabel" Style="{StaticResource LabelStyle}" />
                <TextBlock x:Name="HomeTimerValue" FontSize="28" FontWeight="SemiLight" />
                <TextBlock x:Name="HomeTimerState" Foreground="{StaticResource MutedBrush}" FontSize="12" />
              </StackPanel>
              <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
        <StackPanel x:Name="TimerPage" Spacing="20" Visibility="Collapsed">
          <StackPanel Spacing="8">
            <TextBlock x:Name="TimerHeading" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="TimerDescription" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24,32">
            <StackPanel Spacing="16">
              <TextBlock x:Name="ManualLabel" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" />
              <TextBlock x:Name="TimerValue" Text="00:00:00" FontSize="44" FontWeight="SemiLight" HorizontalAlignment="Center" />
              <TextBlock x:Name="TimerState" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button x:Name="ToggleTimer" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentInkBrush}" FontWeight="SemiBold" MinHeight="52" />
          <Button x:Name="ResetButton" />
          <Border x:Name="ResetPanel" Visibility="Collapsed" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock x:Name="ResetQuestion" FontWeight="SemiBold" />
              <Button x:Name="ResetCancel" />
              <Button x:Name="ResetConfirm" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Spacing="18" Visibility="Collapsed">
          <StackPanel Spacing="8">
            <TextBlock x:Name="SettingsHeading" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SettingsDescription" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock x:Name="AnimationsLabel" FontWeight="SemiBold" />
              <TextBlock x:Name="AnimationsHint" Foreground="{StaticResource MutedBrush}" FontSize="13" />
              <ToggleSwitch x:Name="AnimationsToggle" />
            </StackPanel>
          </Border>
          <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock x:Name="LargeTextLabel" FontWeight="SemiBold" />
              <TextBlock x:Name="LargeTextHint" Foreground="{StaticResource MutedBrush}" FontSize="13" />
              <ToggleSwitch x:Name="LargeTextToggle" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="8">
            <TextBlock x:Name="LanguageLabel" Foreground="{StaticResource MutedBrush}" />
            <Button x:Name="LanguageButton" />
          </StackPanel>
          <StackPanel Spacing="6" Margin="0,4,0,4">
            <TextBlock x:Name="PrivacyTitle" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock x:Name="PrivacyDescription" Foreground="{StaticResource MutedBrush}" FontSize="13" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Spacing="8">
      <TextBlock x:Name="SaveError" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" FontSize="12" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterHint" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Text="0.1.0" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="11" />
      </Grid>
    </StackPanel>
  </Grid>
</Grid>
